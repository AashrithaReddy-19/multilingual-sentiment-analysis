# Copy to .env (optional). Every value has a working default.
# Folder that contains outputs\ (Telugu-only run) and sentiment_app\ (this project)
NLP_ROOT=D:\NLP
# Frontend origins allowed to call the API
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Load the default model at startup (in the background) instead of on the first prediction
PRELOAD_MODEL=true
MAX_TEXT_CHARS=2000
MAX_BATCH_ROWS=2000
MAX_UPLOAD_MB=5
# Frontend dev server: where /api is proxied to
VITE_BACKEND_URL=http://127.0.0.1:8000
